### Create a restaurant
POST http://localhost:8080/api/restaurants
Content-Type: application/json

{
  "name": "Borgerhub",
  "street": "Main Street",
  "number": 123,
  "city": "Antwerpen",
  "country": "TasteLand",
  "contactEmail": "contact@deliciousbites.com",
  "pictureUrls": "http://example.com/pic1.jpg",
  "defaultPreparationTimeInMinutes": 30,
  "typeOfCuisine": "ITALIAN",
  "openingHours": {
    "MONDAY": {"open": "09:00", "close": "22:00"},
    "TUESDAY": {"open": "09:00", "close": "22:00"}
  },
  "owner": { "ownerId": "31e3a110-37f1-4185-8a55-4d0c57963439" }
}

### Get a restaurant
GET http://localhost:8080/api/restaurants/839f80c6-2d35-473b-ae80-58f368bbeed0
Accept: application/json

### Get all restaurants
GET http://localhost:8080/api/restaurants
Accept: application/json

### Update opening-hours of a restaurant
PATCH http://localhost:8080/api/restaurants/079a77cc-01d3-4c7a-ba5e-05008b2706ae/opening-hours
Content-Type: application/json
X-Owner-Id: 31e3a110-37f1-4185-8a55-4d0c57963439

{
  "hoursPerDay": {
    "MONDAY": {"open": "12:00", "close": "22:00"},
    "TUESDAY": {"open": "12:00", "close": "22:00"},
    "WEDNESDAY": {"open": "09:00", "close": "20:00"}
  }
}

### Create a new dish
POST http://localhost:8080/api/dishes
Content-Type: application/json

{
  "name": "Pasta Carbonara",
  "restaurantId": "03080bb4-f5c9-464e-bf00-217d045af233",
  "type": "ENTREE",
  "tags": ["gluten", "dairy"],
  "description": "Classic creamy Italian pasta.",
  "price": 14.5,
  "pictureUrl": "https://cdn.example.com/pasta.jpg",
  "state": "DRAFT"
}

### Create a new dish
POST http://localhost:8080/api/dishes
Content-Type: application/json

{
  "name": "Arros Negre",
  "restaurantId": "03080bb4-f5c9-464e-bf00-217d045af233",
  "type": "ENTREE",
  "tags": ["egg", "lactose"],
  "description": "Rice with seafood and ink from squid.",
  "price": 40,
  "pictureUrl": "https://cuinatsjotri.cat/files/productes/arros-negre-470x470.jpg",
  "state": "DRAFT"
}

### Publish a dish
POST http://localhost:8080/api/dishes/4e36477a-b5fc-4b4b-a51a-9111471e52e5/publish
# TODO: apply security

### Unpublish a dish
POST http://localhost:8080/api/dishes/dcb7058b-992c-46cd-a338-25bb27f4cab0/unpublish
# TODO: apply security

### Edit a dish
PATCH http://localhost:8080/api/dishes/4e36477a-b5fc-4b4b-a51a-9111471e52e5
Content-Type: application/json

{
  "name": "Paella",
  "description": "Rice with seafood and chicken and beans.",
  "price": 30.5,
  "pictureUrl": "https://i.ytimg.com/vi/1MzMde4FzBM/hq720.jpg?sqp=-oaymwEhCK4FEIIDSFryq4qpAxMIARUAAAAAGAElAADIQj0AgKJD&rs=AOn4CLCq_CZLPwDzuIgbMYWTlK3Sz-ifxQ",
  "type": "SPECIALS",
  "tags": [
    { "tag": "gluten" },
    { "tag": "seafood" }
  ]
}

### Change state dish, out of stok or back on stock
POST http://localhost:8080/api/dishes/dc6460d3-7ce9-4b2f-ae20-302ebaad1693/changeState

### Schedule Publish a group of dishes
POST http://localhost:8080/api/schedules
Content-Type: application/json

{
  "dishIds": ["4e36477a-b5fc-4b4b-a51a-9111471e52e5", "dcb7058b-992c-46cd-a338-25bb27f4cab0"],
  "action": "PUBLISHED",
  "scheduledTime": "2025-10-19T11:45:00"
}


### Get all restaurants projections
GET http://localhost:8080/api/orders/restaurants
Accept: application/json

### Get a restaurant with its details
GET http://localhost:8080/api/orders/restaurants/03080bb4-f5c9-464e-bf00-217d045af233
Accept: application/json

### Filter dishes with tags and type
GET http://localhost:8080/api/orders/restaurants/03080bb4-f5c9-464e-bf00-217d045af233/dishes?type=&tags=gluten
Accept: application/json
