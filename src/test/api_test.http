### Create a restaurant
POST http://localhost:8080/api/restaurants
Content-Type: application/json

{
  "name": "Borgerhub",
  "street": "Main Street",
  "number": 123,
  "city": "Antwerpen",
  "country": "TasteLand",
  "contactEmail": "contact@deliciousbites.com",
  "pictureUrls": "http://example.com/pic1.jpg",
  "defaultPreparationTimeInMinutes": 30,
  "typeOfCuisine": "ITALIAN",
  "openingHours": {
    "MONDAY": {"open": "09:00", "close": "22:00"},
    "TUESDAY": {"open": "09:00", "close": "22:00"}
  },
  "owner": { "ownerId": "31e3a110-37f1-4185-8a55-4d0c57963439" }
}

### Get a restaurant
GET http://localhost:8080/api/restaurants/839f80c6-2d35-473b-ae80-58f368bbeed0
Accept: application/json

### Get all restaurants
GET http://localhost:8080/api/restaurants
Accept: application/json

### Update opening-hours of a restaurant
PATCH http://localhost:8080/api/restaurants/839f80c6-2d35-473b-ae80-58f368bbeed0/opening-hours
Content-Type: application/json
X-Owner-Id: 31e3a110-37f1-4185-8a55-4d0c57963439

{
  "hoursPerDay": {
    "MONDAY": {"open": "12:00", "close": "22:00"},
    "TUESDAY": {"open": "12:00", "close": "22:00"},
    "WEDNESDAY": {"open": "09:00", "close": "20:00"}
  }
}

### Create a new dish
POST http://localhost:8080/api/dishes
Content-Type: application/json

{
  "name": "Pasta Carbonara",
  "restaurantId": "31e3a110-37f1-4185-8a55-4d0c57963439",
  "type": "ENTREE",
  "tags": ["gluten", "dairy"],
  "description": "Classic creamy Italian pasta.",
  "price": 14.5,
  "pictureUrl": "https://cdn.example.com/pasta.jpg",
  "state": "DRAFT"
}

### Create a new dish
POST http://localhost:8080/api/dishes
Content-Type: application/json

{
  "name": "Arroz a la Cubana",
  "restaurantId": "31e3a110-37f1-4185-8a55-4d0c57963439",
  "type": "ENTREE",
  "tags": ["egg", "lactose"],
  "description": "White rice with tomato sauce. With a fried egg on top and some parmesan",
  "price": 9.5,
  "pictureUrl": "https://cdn.example.com/pasta.jpg",
  "state": "DRAFT"
}

### Publish a dish
POST http://localhost:8080/api/dishes/8490c201-d893-4169-90aa-90cd770beb58/publish
# TODO: apply security

### Unpublish a dish
POST http://localhost:8080/api/dishes/8490c201-d893-4169-90aa-90cd770beb58/unpublish
