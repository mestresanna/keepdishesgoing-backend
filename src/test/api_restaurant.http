POST http://localhost:8180/realms/keepdishesgoing/protocol/openid-connect/token HTTP/1.1
Content-Type: application/x-www-form-urlencoded

client_id=backend-client&client_secret=yUC8fRkoygfAaw86ek1n2azv5eAtUL1e&username=owner&password=owner&grant_type=password

//saving the access token
> {%
    client.global.set("access_token", response.body.access_token);
%}

### Create a restaurant
POST http://localhost:8080/api/restaurants
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "name": "Ernst",
  "street": "Main Street",
  "number": 12,
  "city": "Antwerpen",
  "country": "Belgium",
  "contactEmail": "contact@deliciousbites.com",
  "pictureUrls": "https://www.trips.beer/wp-content/uploads/2022/10/an-overview-of-the-interior-of-cafe-ernst.jpg",
  "defaultPreparationTimeInMinutes": 30,
  "typeOfCuisine": "BELGIAN",
  "openingHours": {
    "MONDAY": {"open": "12:00", "close": "22:00"},
    "TUESDAY": {"open": "12:00", "close": "22:00"}
  }
}



### Get a restaurant
GET http://localhost:8080/api/restaurants/839f80c6-2d35-473b-ae80-58f368bbeed0
Accept: application/json
Authorization: Bearer {{access_token}}

### Get all restaurants
GET http://localhost:8080/api/restaurants
Accept: application/json
Authorization: Bearer {{access_token}}

### Update opening-hours of a restaurant
PATCH http://localhost:8080/api/restaurants/079a77cc-01d3-4c7a-ba5e-05008b2706ae/opening-hours
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "hoursPerDay": {
    "MONDAY": {"open": "12:00", "close": "22:00"},
    "TUESDAY": {"open": "12:00", "close": "22:00"},
    "WEDNESDAY": {"open": "09:00", "close": "20:00"}
  }
}

### Create a new dish
POST http://localhost:8080/api/dishes
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "name": "Pasta Carbonara",
  "restaurantId": "03080bb4-f5c9-464e-bf00-217d045af233",
  "type": "ENTREE",
  "tags": ["gluten", "dairy"],
  "description": "Classic creamy Italian pasta.",
  "price": 14.5,
  "pictureUrl": "https://cdn.example.com/pasta.jpg",
  "state": "DRAFT"
}

### Create a new dish
POST http://localhost:8080/api/dishes
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "name": "Arros Negre",
  "type": "ENTREE",
  "tags": ["egg", "lactose"],
