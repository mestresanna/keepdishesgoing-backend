### Create a restaurant
POST http://localhost:8080/api/restaurants
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "name": "Ernst",
  "street": "Ernest Van Dijckkaai",
  "number": 18,
  "city": "Antwerpen",
  "postalCode": "2000",
  "country": "Belgium",
  "contactEmail": "cafeernstantwerp@gmail.com",
  "pictureUrls": "https://www.trips.beer/wp-content/uploads/2022/10/an-overview-of-the-interior-of-cafe-ernst.jpg",
  "defaultPreparationTimeInMinutes": 15,
  "typeOfCuisine": "BELGIAN",
  "openingHours": {
    "MONDAY": {"open": "15:00", "close": "00:00"},
    "THURSDAY": {"open": "15:00", "close": "00:00"},
    "FRIDAY": {"open": "15:00", "close": "01:00"},
    "SATURDAY": {"open": "14:00", "close": "01:00"},
    "SUNDAY": {"open": "14:00", "close": "22:00"}
  }
}



### Get a restaurant
GET http://localhost:8080/api/restaurants/839f80c6-2d35-473b-ae80-58f368bbeed0
Accept: application/json
Authorization: Bearer {{access_token}}

### Get all restaurants
GET http://localhost:8080/api/restaurants
Accept: application/json
Authorization: Bearer {{access_token}}

### Update opening-hours of a restaurant
PATCH http://localhost:8080/api/restaurants/6d488e14-cc5e-4565-a69e-d6cf2ee7b0d7/opening-hours
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "hoursPerDay": {
    "MONDAY": {"open": "12:00", "close": "22:00"},
    "TUESDAY": {"open": "12:00", "close": "22:00"},
    "WEDNESDAY": {"open": "09:00", "close": "20:00"}
  }
}

### Create a new dish
POST http://localhost:8080/api/dishes
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "name": "Pasta Carbonara",
  "restaurantId": "6d488e14-cc5e-4565-a69e-d6cf2ee7b0d7",
  "type": "ENTREE",
  "tags": ["gluten", "dairy"],
  "description": "Classic creamy Italian pasta.",
  "price": 14.5,
  "pictureUrl": "https://leitesculinaria.com/wp-content/uploads/2024/04/spaghetti-carbonara-1200.jpg",
  "state": "DRAFT"
}

